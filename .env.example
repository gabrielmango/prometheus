# =============================================================================
# Prometheus - Exemplo de variaveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA faca commit do arquivo `.env` com credenciais reais.
# =============================================================================

# Ambiente ativo por padrao: dev | tst | hml | preprod | prod
PROMETHEUS_ENV=dev

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MongoDB (origem) - uma URI por ambiente
# -----------------------------------------------------------------------------
MONGO_URI_DEV=mongodb://usuario:senha@localhost:27017/?authSource=admin
MONGO_URI_TST=mongodb://usuario:senha@host-tst:27017/?authSource=admin
MONGO_URI_HML=mongodb://usuario:senha@host-hml:27017/?authSource=admin
MONGO_URI_PREPROD=mongodb://usuario:senha@host-preprod:27017/?authSource=admin
MONGO_URI_PROD=mongodb://usuario:senha@host1:27017,host2:27017,host3:27017/?authSource=admin&replicaSet=rs-prod&readPreference=primary

# Banco MongoDB padrao
MONGO_DB_NAME=app_db

# -----------------------------------------------------------------------------
# PostgreSQL (destino/origem) - uma URI por ambiente
# Formato: postgresql+psycopg2://usuario:senha@host:porta/banco
# -----------------------------------------------------------------------------
POSTGRES_URI_DEV=postgresql+psycopg2://usuario:senha@localhost:5432/app_db
POSTGRES_URI_TST=postgresql+psycopg2://usuario:senha@host-tst:5432/app_db
POSTGRES_URI_HML=postgresql+psycopg2://usuario:senha@host-hml:5432/app_db
POSTGRES_URI_PREPROD=postgresql+psycopg2://usuario:senha@host-preprod:5432/app_db
POSTGRES_URI_PROD=postgresql+psycopg2://usuario:senha@host-prod:5432/app_db

# Schema padrao usado para cargas (LOAD)
POSTGRES_LOAD_SCHEMA=analytics
